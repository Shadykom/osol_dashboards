# OSOL API Environment Configuration
# ====================================
# Copy this file to .env and configure for your environment

# Server
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Logging
LOG_LEVEL=debug

# Database (Supabase PostgreSQL)
DB_HOST=db.bzlenegoilnswsbanxgb.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_SCHEMA=kastle_banking
DB_SSL=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Tenant
# Default tenant ID for development (if x-tenant-id header not provided)
# DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# RBAC
RBAC_ENABLED=true
RBAC_DEV_BYPASS=true

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Future Auth Configuration (EPIC 2+)
# JWT_SECRET=your-jwt-secret
# JWT_EXPIRES_IN=1h

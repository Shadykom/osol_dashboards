# Oracle Database Configuration
# Copy this file to .env and fill in your Oracle database credentials

# Basic Oracle Connection Settings
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECTION_STRING=hostname:1521/servicename

# Connection Pool Settings (optional - defaults shown)
ORACLE_POOL_MIN=4
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
ORACLE_POOL_PING_INTERVAL=60
ORACLE_QUEUE_TIMEOUT=60000
ORACLE_QUEUE_MAX=500

# Oracle Wallet Settings (optional - for secure authentication)
# ORACLE_WALLET_LOCATION=/path/to/wallet
# ORACLE_WALLET_PASSWORD=wallet_password

# Example connection strings:
# - Standard: localhost:1521/ORCL
# - With domain: myhost.mydomain.com:1521/ORCL
# - RAC: (DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=host1)(PORT=1521))(ADDRESS=(PROTOCOL=TCP)(HOST=host2)(PORT=1521)))(CONNECT_DATA=(SERVICE_NAME=myservice)))
# - Easy Connect Plus: myhost:1521/myservice:pooled

# For Oracle Cloud Autonomous Database:
# ORACLE_CONNECTION_STRING=adb.region.oraclecloud.com:1522/unique_name_high.adb.oraclecloud.com
# And use wallet authentication
# CMS API Environment Configuration
# ==================================
# Copy this file to .env and configure for your environment

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Logging
LOG_LEVEL=debug

# =============================================================================
# Database Connection (Supabase PostgreSQL)
# =============================================================================
# Option 1: Single connection string (recommended)
# Get this from: Supabase Dashboard -> Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Option 2: Individual connection parameters (alternative)
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-database-password
# DB_SSL=true

# Database Pool Configuration
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_SSL=true

# Database Schema (default: platform for EPIC 1)
DB_SCHEMA=platform

# =============================================================================
# Multi-Tenant Configuration
# =============================================================================
# Default tenant ID for development (used when x-tenant-id header not provided)
# WARNING: Never set this in production - always require explicit tenant header
DEFAULT_TENANT_FOR_DEV=11111111-1111-1111-1111-111111111111

# =============================================================================
# RBAC Configuration
# =============================================================================
RBAC_ENABLED=true

# Bypass RBAC checks in development (set to false in production!)
RBAC_DEV_BYPASS=true

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins, or '*' for all (dev only)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# =============================================================================
# Future Configuration (EPIC 2+)
# =============================================================================
# JWT Configuration (for auth module)
# JWT_SECRET=your-jwt-secret-min-32-chars
# JWT_EXPIRES_IN=1h
# JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
